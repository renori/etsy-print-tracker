# Copy this to .env next to docker-compose.yml.

# Port the web UI and API are served on (host and container).
PORT=9999
# Timezone for the print schedule (morning start, home time, blackouts).
TZ=America/Los_Angeles

# Etsy sync — create an app at https://www.etsy.com/developers/your-apps.
# Leave blank to run the tracker without Etsy sync; everything else works.
ETSY_API_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
# Must exactly match the redirect URI registered on your Etsy app, and be
# reachable from your browser — e.g. http://<nas-ip>:9999/api/etsy/callback
ETSY_REDIRECT_URI=

# Optional — adds an AI receipt reader on the Expenses page (console.anthropic.com → API keys).
# The free built-in reader (Amazon emails/invoices, store receipts, screenshots) works without it.
ANTHROPIC_API_KEY=

# Folder on the NAS for nightly backups (sync it to Google Drive with CloudSync).
BACKUP_PATH=/Volume1/Backups/print-tracker
# Optional: when to back up (local time) and how many days of nightly backups to keep.
# BACKUP_TIME=03:15
# BACKUP_KEEP_DAYS=30
